    "traceform-lowmemory16-device-run.sh": "#!/system/bin/sh\nroot=/data/local/tmp/traceform-lowmemory-private-16-20261002\nexec 3<&0\n(\n    printf 1000 > /proc/self/oom_score_adj || exit 2\n    exec \"$@\"\n) <&3 &\nparticipant=$!\nprintf '%s\\n' \"$participant\" > \"$root/participant.pid\"\ncleanup() {\n    kill \"$participant\" 2>/dev/null\n    [ -n \"$watcher\" ] && kill \"$watcher\" 2>/dev/null\n}\ntrap cleanup EXIT INT TERM\n(\n    peak=0\n    while [ -r \"/proc/$participant/status\" ]; do\n        rss=$(awk '/^VmRSS:/ {print $2}' \"/proc/$participant/status\")\n        available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)\n        [ -n \"$rss\" ] && [ \"$rss\" -gt \"$peak\" ] && peak=$rss\n        printf '%s\\n' \"$peak\" > \"$root/rss-$participant.kib\"\n        if { [ -n \"$rss\" ] && [ \"$rss\" -gt 790000 ]; } || [ \"$available\" -lt 196608 ]; then\n            printf 'synthetic participant resource boundary: rss=%s available=%s\\n' \"$rss\" \"$available\" >&2\n            kill \"$participant\"\n            break\n        fi\n        sleep .2\n    done\n) &\nwatcher=$!\nwait \"$participant\"\nresult=$?\nkill \"$watcher\" 2>/dev/null\nwait \"$watcher\" 2>/dev/null\ntrap - EXIT INT TERM\nexit \"$result\"\n",
