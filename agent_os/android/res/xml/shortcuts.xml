<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="audit_log"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_audit_short"
        android:shortcutLongLabel="@string/shortcut_audit_long">
        <intent
            android:action="com.inceptless.traceweave.OPEN_AUDIT"
            android:targetPackage="com.inceptless.traceweave"
            android:targetClass="com.inceptless.traceweave.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_task_short"
        android:shortcutLongLabel="@string/shortcut_task_long">
        <intent
            android:action="com.inceptless.traceweave.NEW_TASK"
            android:targetPackage="com.inceptless.traceweave"
            android:targetClass="com.inceptless.traceweave.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="task_center"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_center_short"
        android:shortcutLongLabel="@string/shortcut_center_long">
        <intent
            android:action="com.inceptless.traceweave.OPEN_CENTER"
            android:targetPackage="com.inceptless.traceweave"
            android:targetClass="com.inceptless.traceweave.MainActivity" />
    </shortcut>
</shortcuts>
