<?xml version="1.0" encoding="utf-8"?>
<!--
  The task and memory payloads are sealed with an Android Keystore key that never leaves
  this device. Copying the database to another device therefore produces rows that can
  never be read, so migration must go through the encrypted archive instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
