<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.traceform.agentos.actionsvalidation" android:versionCode="1" android:versionName="0.1-actions">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent><action android:name="android.intent.action.INSERT" /><data android:mimeType="vnd.android.cursor.dir/event" /></intent>
    </queries>
    <application android:allowBackup="false" android:debuggable="true" android:label="Agent OS Action Validation"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" android:usesCleartextTraffic="false">
        <service android:name="org.traceform.agentos.AgentJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <activity android:name="org.traceform.agentos.AutoSyncProbe" android:exported="true" />
        <activity android:name="org.traceform.agentos.MainActivity" android:exported="true" />
        <activity android:name="org.traceform.agentos.ExternalActionActivity" android:exported="false" />
        <activity android:name="org.traceform.agentos.DeviceValidationActivity" android:exported="true" />
        <activity android:name="org.traceform.agentos.ActionFlowValidationActivity" android:exported="true" />
    </application>
</manifest>
